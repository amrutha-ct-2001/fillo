# --- Local development ---
SECRET_KEY=change-me-in-production
DEBUG=True
# Staging/production: ALLOWED_HOSTS=fillo.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite for local dev. For production:
# DATABASE_URL=postgres://user:pass@localhost:5432/fillo
DATABASE_URL=
# OTP_MODE=static -> one fixed code, development only.
# OTP_MODE=sms    -> random 6-digit code texted to the customer (use this in production).
OTP_MODE=static
# With OTP_MODE=sms: SMS_BACKEND=console prints the code in the server log (local testing).
# For real SMS: SMS_BACKEND=msg91, MSG91_AUTH_KEY=..., MSG91_TEMPLATE_ID=... (DLT-approved template)
# SMS_BACKEND=console
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=30
# OTP_MAX_ATTEMPTS=5
STATIC_OTP=123456
MEDIA_ROOT=
CORS_ALLOWED_ORIGINS=*

# --- Production (DEBUG=False) ---
# SECRET_KEY is required (long random string).
# Static OTP lets anyone log in as any customer by phone number, so the server
# refuses to start with OTP_MODE=static unless you opt in knowingly:
# ALLOW_STATIC_OTP=True
# STATIC_OTP=<not 123456>
# seed_fillo needs explicit non-trivial PINs and never resets existing ones:
# SEED_ADMIN_PIN=
# SEED_STAFF_PIN=
# Shared rate-limit counters (all gunicorn workers); default is server/.cache
# CACHE_DIR=/var/www/fillo/cache
# Throttle overrides (DRF format): THROTTLE_PIN_LOGIN=10/hour
